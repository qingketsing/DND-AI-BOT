BASE_URL=http://localhost:8080
EMAIL=loadtest@example.com
PASSWORD=Password123!
CHANNEL=web

# L1 / L2 / L3
MESSAGE_MODE=L1

# k6 stage syntax: vus:duration,vus:duration
STAGES=1:3m,2:3m,5:3m,10:3m

# per-message think time inside one VU
THINK_TIME_SECONDS=1

# request timeout passed to k6 http client
REQUEST_TIMEOUT=180s
